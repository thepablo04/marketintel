{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/build_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.pyc,**/*.md,**/*.bat,**/.env*,**/*.sqlite*,**/*.db,public/**,MarketIntel-v6.4/static/**}"
    }
  }
}
